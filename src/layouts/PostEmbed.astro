---
const { frontmatter } = Astro.props;
const { title, date, tags = [], issue, excerpt, lang = 'es' } = frontmatter;
const dateFormatted = new Date(date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — PIXEL</title>
  <meta name="description" content={excerpt ?? 'Artículo de PIXEL'} />
  <link rel="stylesheet" href="/styles/global.css" />
</head>
<body class="embed-post">
  <article class="embed-post-shell">
    <div class="post-header">
      <div class="post-header-meta">
        <span class="post-date">{dateFormatted}</span>
        <div class="post-tags">
          {issue && <span class="post-tag post-tag-issue">nº{issue}</span>}
          {tags.map((tag: string) => (
            <span class="post-tag">{tag}</span>
          ))}
        </div>
      </div>
      <h1>{title}</h1>
      {excerpt && <p class="post-excerpt-header">{excerpt}</p>}
    </div>

    <div class="post-layout">
      <nav id="toc" aria-label="Índice" hidden></nav>
      <div class="post-body">
        <slot />
      </div>
    </div>
  </article>

  <style is:global>
    body.embed-post {
      padding: 0;
      background: #fff;
      overflow-x: hidden;
    }

    .embed-post-shell {
      max-width: 720px;
      margin: 0 auto;
      padding: 2rem 1.25rem 4rem;
    }

    .embed-post .post-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
      border-bottom: 3px solid var(--text);
    }

    .embed-post .post-header-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
      margin-bottom: 1rem;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
    }

    .embed-post .post-date { color: var(--text-muted); }
    .embed-post .post-tags { display: flex; gap: 0.4rem; flex-wrap: wrap; }

    .embed-post .post-header h1 {
      font-size: clamp(2rem, 5vw, 3.4rem);
      line-height: 1.05;
      font-weight: 700;
      letter-spacing: -0.02em;
      margin: 0 0 1rem;
    }

    .embed-post .post-excerpt-header {
      font-size: 1.05rem;
      color: var(--text-muted);
      font-style: italic;
      line-height: 1.55;
      margin: 0;
      max-width: 600px;
    }

    .embed-post .post-layout { position: relative; }
    .embed-post .post-body { margin-top: 2rem; }

    .embed-post .post-body > p:first-of-type::first-letter {
      font-size: 6.5em;
      font-weight: 700;
      float: left;
      line-height: 0.75;
      margin: 0.04em 0.12em 0 0;
      color: var(--red);
      font-family: var(--font-serif);
    }

    .embed-post #toc {
      position: sticky;
      top: 2rem;
      float: right;
      clear: right;
      width: 220px;
      margin-left: 2rem;
      margin-right: -250px;
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.6;
    }

    .embed-post #toc ul {
      list-style: none;
      border-left: 2px solid var(--border);
      padding-left: 0.75rem;
    }

    .embed-post #toc li { margin-bottom: 0.35rem; }

    .embed-post #toc a {
      text-decoration: none;
      color: var(--text-muted);
      transition: color 0.15s;
      display: block;
      white-space: normal;
    }

    .embed-post #toc a:hover,
    .embed-post #toc a.active { color: var(--red); }

    .embed-post #toc .toc-title {
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--red);
      font-size: 0.62rem;
      margin-bottom: 0.5rem;
      display: block;
    }

    .embed-post .post-tag {
      color: var(--red);
      font-size: 0.75rem;
    }

    .embed-post .post-tag::before { content: '#'; }
    .embed-post .post-tag-issue::before { content: ''; }

    @media (max-width: 980px) {
      .embed-post #toc { display: none !important; }
    }

    @media (max-width: 700px) {
      .embed-post-shell {
        padding: 1.15rem 0.9rem 3rem;
      }

      .embed-post .post-header {
        margin-bottom: 2rem;
        padding-bottom: 1.2rem;
      }

      .embed-post .post-body > p:first-of-type::first-letter {
        font-size: 4.7em;
      }
    }
  </style>

  <script>
    const toc = document.getElementById('toc');
    const body = document.querySelector('.post-body');
    if (toc && body) {
      const headings = [...body.querySelectorAll('h2')];
      if (headings.length >= 2) {
        toc.hidden = false;
        const title = document.createElement('span');
        title.className = 'toc-title';
        title.textContent = 'Índice';
        const ul = document.createElement('ul');
        headings.forEach((h, i) => {
          if (!h.id) h.id = `section-${i}`;
          const li = document.createElement('li');
          const a = document.createElement('a');
          a.href = `#${h.id}`;
          a.textContent = h.textContent;
          li.appendChild(a);
          ul.appendChild(li);
        });
        toc.appendChild(title);
        toc.appendChild(ul);
      }
    }
  </script>
</body>
</html>
