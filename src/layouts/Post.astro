---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, date, tags = [], issue, excerpt, lang = 'es' } = frontmatter;
const dateFormatted = new Date(date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---
<Base title={title} description={excerpt}>
  <article>
    <div class="post-header">
      <div class="post-header-meta">
        <span class="post-date">{dateFormatted}</span>
        <div class="post-tags">
          {tags.map((tag: string) => (
            <a href={`/tags/${tag}`} class="post-tag">{tag}</a>
          ))}
        </div>
      </div>
      <h1>{title}</h1>
      {excerpt && <p class="post-excerpt-header">{excerpt}</p>}
    </div>

    <div class="post-layout">
      <nav id="toc" aria-label="Índice" hidden></nav>
<div class="post-body">
        <slot />
      </div>
    </div>

    <!-- Newsletter al final de cada artículo -->
    <div class="newsletter-block">
      <h3>¿Te ha gustado?</h3>
      <p>Suscríbete para recibir nuevos artículos y los números del fanzine cuando salgan.</p>
      <form class="newsletter-form" action="/api/subscribe" method="POST">
        <input type="email" name="email" placeholder="tu@email.com" required />
        <button type="submit">Suscribirse</button>
      </form>
    </div>
  </article>
</Base>

<style is:global>
/* ── Post header ── */
.post-header {
  margin-bottom: 3rem;
  padding-bottom: 2rem;
  border-bottom: 3px solid var(--text);
}

.post-header-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.4rem 1rem;
  margin-bottom: 1rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}

.post-date { color: var(--text-muted); }

.post-tags { display: flex; gap: 0.4rem; }

.post-header h1 {
  font-size: clamp(2rem, 5vw, 3.4rem);
  line-height: 1.05;
  font-weight: 700;
  letter-spacing: -0.02em;
  margin: 0 0 1rem;
}

.post-excerpt-header {
  font-size: 1.05rem;
  color: var(--text-muted);
  font-style: italic;
  line-height: 1.55;
  margin: 0;
  max-width: 600px;
}

/* ── Layout ── */
.post-layout {
  position: relative;
}

.post-body { margin-top: 2rem; }

/* Drop cap más dramático */
.post-body > p:first-of-type::first-letter {
  font-size: 6.5em;
  font-weight: 700;
  float: left;
  line-height: 0.75;
  margin: 0.04em 0.12em 0 0;
  color: var(--red);
  font-family: var(--font-serif);
}

#toc {
  position: sticky;
  top: 2rem;
  float: right;
  clear: right;
  width: 220px;
  margin-left: 2rem;
  margin-right: -250px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  line-height: 1.6;
}

#toc ul {
  list-style: none;
  border-left: 2px solid var(--border);
  padding-left: 0.75rem;
}

#toc li { margin-bottom: 0.35rem; }

#toc a {
  text-decoration: none;
  color: var(--text-muted);
  transition: color 0.15s;
  display: block;
  white-space: normal;
}
#toc a:hover,
#toc a.active { color: var(--red); }

#toc .toc-title {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--red);
  font-size: 0.62rem;
  margin-bottom: 0.5rem;
  display: block;
}

@media (max-width: 980px) {
  #toc { display: none !important; }
}
</style>

<script>
  const toc = document.getElementById('toc');
  const body = document.querySelector('.post-body');
  if (toc && body) {
    const headings = [...body.querySelectorAll('h2')];
    if (headings.length >= 2) {
      toc.hidden = false;
      const title = document.createElement('span');
      title.className = 'toc-title';
      title.textContent = 'Índice';
      const ul = document.createElement('ul');
      headings.forEach((h, i) => {
        if (!h.id) h.id = `section-${i}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(title);
      toc.appendChild(ul);

      // Highlight active section on scroll
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const link = toc.querySelector(`a[href="#${entry.target.id}"]`);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        });
      }, { rootMargin: '0px 0px -70% 0px' });
      headings.forEach(h => observer.observe(h));

      // Ocultar TOC solo cuando se solapa visualmente con la galería
      const gallery = body.querySelector('.gallery-wrap');
      if (gallery) {
        function checkOverlap() {
          const tocRect = toc.getBoundingClientRect();
          const galleryRect = gallery.getBoundingClientRect();
          const overlaps = galleryRect.top < tocRect.bottom && galleryRect.bottom > tocRect.top;
          toc.style.opacity = overlaps ? '0' : '';
          toc.style.pointerEvents = overlaps ? 'none' : '';
          toc.style.transition = 'opacity 0.2s';
        }
        window.addEventListener('scroll', checkOverlap, { passive: true });
        checkOverlap();
      }

    }
  }
</script>
