---
import Base from './Base.astro';
const { frontmatter } = Astro.props;
const { title, date, tags = [], issue, excerpt, lang = 'es' } = frontmatter;
const dateFormatted = new Date(date).toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---
<Base title={title} description={excerpt}>
  <article>
    <h1>{title}</h1>

    <div class="post-meta">
      <span>{dateFormatted}</span>
      {issue && (
        <a href={`/descargas#numero-${issue}`} class="issue-badge">Nº{issue}</a>
      )}
      {tags.map((tag: string) => (
        <a href={`/tags/${tag}`} class="post-tag">{tag}</a>
      ))}
    </div>

    <div class="post-layout">
      <nav id="toc" aria-label="Índice" hidden></nav>
      <div class="post-body">
        <slot />
      </div>
    </div>

    <!-- Newsletter al final de cada artículo -->
    <div class="newsletter-block">
      <h3>¿Te ha gustado?</h3>
      <p>Suscríbete para recibir nuevos artículos y los números del fanzine cuando salgan.</p>
      <form class="newsletter-form" action="/api/subscribe" method="POST">
        <input type="email" name="email" placeholder="tu@email.com" required />
        <button type="submit">Suscribirse</button>
      </form>
    </div>
  </article>
</Base>

<style is:global>
.post-layout {
  position: relative;
}

.post-body { margin-top: 2rem; }

/* Drop cap — is:global porque el contenido viene del slot (Markdown) */
.post-body > p:first-of-type::first-letter {
  font-size: 4.2em;
  font-weight: 700;
  float: left;
  line-height: 0.82;
  margin: 0.06em 0.1em 0 0;
  color: var(--text);
}

#toc {
  position: sticky;
  top: 2rem;
  float: right;
  clear: right;
  width: 160px;
  margin-left: 2rem;
  margin-right: -190px;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  line-height: 1.6;
}

#toc ul {
  list-style: none;
  border-left: 2px solid var(--border);
  padding-left: 0.75rem;
}

#toc li { margin-bottom: 0.35rem; }

#toc a {
  text-decoration: none;
  color: var(--text-muted);
  transition: color 0.15s;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
#toc a:hover,
#toc a.active { color: var(--red); }

#toc .toc-title {
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--text-muted);
  font-size: 0.62rem;
  margin-bottom: 0.5rem;
  display: block;
}

@media (max-width: 980px) {
  #toc { display: none !important; }
}
</style>

<script>
  const toc = document.getElementById('toc');
  const body = document.querySelector('.post-body');
  if (toc && body) {
    const headings = [...body.querySelectorAll('h2')];
    if (headings.length >= 2) {
      toc.hidden = false;
      const title = document.createElement('span');
      title.className = 'toc-title';
      title.textContent = 'Índice';
      const ul = document.createElement('ul');
      headings.forEach((h, i) => {
        if (!h.id) h.id = `section-${i}`;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `#${h.id}`;
        a.textContent = h.textContent;
        li.appendChild(a);
        ul.appendChild(li);
      });
      toc.appendChild(title);
      toc.appendChild(ul);

      // Highlight active section on scroll
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          const link = toc.querySelector(`a[href="#${entry.target.id}"]`);
          if (link) link.classList.toggle('active', entry.isIntersecting);
        });
      }, { rootMargin: '0px 0px -70% 0px' });
      headings.forEach(h => observer.observe(h));
    }
  }
</script>
