---
import '98.css/dist/98.css';
interface PostFile {
  id: string;
  title: string;
  date: string;
  excerpt: string;
  tags: string[];
  issue?: number;
}

interface IssueFile {
  number: number;
  title: string;
  date: string;
  pdf?: string;
  pdfPrint?: string;
}

interface Props {
  posts: PostFile[];
  issues: IssueFile[];
}

const { posts, issues } = Astro.props;
const iconUrls = {
  desktop: {
    folder: '/icons/react95/explorer-32.png',
    interview: '/icons/react95/notepad-32.png',
    arcade: '/icons/react95/exe-32.png',
    fanzines: '/icons/react95/notepad-32.png',
    computer: '/icons/react95/computer-32.png',
    settings: '/icons/react95/settings-32.png',
    taisei: '/icons/taisei-32.png',
    doom: '/icons/doom-32-new.png',
    video: '/icons/video-32.png',
    mplayer: '/icons/mplayer-32.png',
  },
  files: {
    article: '/icons/react95/html-16.png',
    pdf: '/icons/react95/file-32.png',
    folder: '/icons/react95/folder-16.png',
    window: '/icons/react95/folder-16.png',
    video: '/icons/react95/folder-closed-16.png',
    videoFile: '/icons/claqueta-16.png',
    music: '/icons/musiccd-16.png',
  },
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=1024" id="viewport-meta" />
  <script>if (/Mobi|Android|iPhone|iPad|iPod/i.test(navigator.userAgent)) { document.getElementById('viewport-meta').content = 'width=device-width, initial-scale=1, maximum-scale=1'; document.documentElement.classList.add('is-mobile'); }</script>
  <meta name="description" content="bitmag — blog independiente de videojuegos" />
  <title>bitOS 26 — bitmag</title>
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="stylesheet" href="/styles/pixelos.css" />
  <script src="https://unpkg.com/webamp@1.5.0/built/webamp.bundle.min.js"></script>
</head>
<body>
  <div id="pixel-os" class="pixel-os wallpaper-segasky">
    <main class="desktop" aria-label="Escritorio bitOS">
      <div class="desktop-selection-box" id="desktop-selection-box" hidden></div>
      <ul class="desktop-icons">
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" data-desktop-folder="all"><img class="desktop-icon-image" src={iconUrls.desktop.folder} alt="" /><div class="border-box"><p class="desktop-icon-label">Explorador</p></div></button></li>
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" data-desktop-window="about"><img class="desktop-icon-image" src={iconUrls.desktop.computer} alt="" /><div class="border-box"><p class="desktop-icon-label">Mi bitmag</p></div></button></li>
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" data-desktop-window="settings"><img class="desktop-icon-image" src={iconUrls.desktop.settings} alt="" /><div class="border-box"><p class="desktop-icon-label">Panel de control</p></div></button></li>
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" data-desktop-window="taisei"><img class="desktop-icon-image" src={iconUrls.desktop.taisei} alt="" /><div class="border-box"><p class="desktop-icon-label">Taisei Project</p></div></button></li>
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-window="doom"><img class="desktop-icon-image" src={iconUrls.desktop.doom} alt="" /><div class="border-box"><p class="desktop-icon-label">DOOM</p></div></button></li>
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" data-desktop-folder="videos"><img class="desktop-icon-image" src={iconUrls.desktop.video} alt="" /><div class="border-box"><p class="desktop-icon-label">Vídeos</p></div></button></li>
        <li class="desktop-icon-item" data-mobile><button class="desktop-icon" id="winamp-icon" data-desktop-window="winamp"><img class="desktop-icon-image" src="/icons/winamp-32.png" alt="" /><div class="border-box"><p class="desktop-icon-label">Winamp</p></div></button></li>
      </ul>


      <section class="window os-window explorer-window" id="window-explorer" hidden>
        <div class="title-bar">
          <div class="title-bar-text"><img class="window-title-icon" src={iconUrls.files.window} alt="" /><span id="explorer-title">Explorador</span></div>
          <div class="title-bar-controls"><button aria-label="Minimize" data-action="minimize" data-minimize></button><button aria-label="Maximize" data-action="maximize" data-maximize></button><button aria-label="Close" data-action="close" class="close" data-close></button></div>
        </div>
        <div class="window-body explorer-shell">
          <div class="explorer-menu-bar" role="menubar" aria-label="Menú del explorador">
            <button type="button">Archivo</button>
            <button type="button">Edición</button>
            <button type="button">Ver</button>
            <button type="button">Ir</button>
            <button type="button">Favoritos</button>
            <button type="button">Ayuda</button>
          </div>
          <div class="explorer-icon-toolbar">
            <button type="button" id="explorer-back" class="toolbar-btn" aria-label="Atrás" title="Atrás">
              <img src="/icons/toolbar/back.png" alt="" /><span>Atrás</span>
            </button>
            <button type="button" id="explorer-up" class="toolbar-btn" aria-label="Subir" title="Subir un nivel">
              <img src="/icons/toolbar/up.png" alt="" /><span>Subir</span>
            </button>
            <span class="toolbar-sep"></span>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Cortar" title="Cortar">
              <img src="/icons/toolbar/cut.png" alt="" /><span>Cortar</span>
            </button>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Copiar" title="Copiar">
              <img src="/icons/toolbar/copy.png" alt="" /><span>Copiar</span>
            </button>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Pegar" title="Pegar">
              <img src="/icons/toolbar/paste.png" alt="" /><span>Pegar</span>
            </button>
            <span class="toolbar-sep"></span>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Eliminar" title="Eliminar">
              <img src="/icons/toolbar/delete.png" alt="" /><span>Eliminar</span>
            </button>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Propiedades" title="Propiedades">
              <img src="/icons/toolbar/properties.png" alt="" /><span>Propiedades</span>
            </button>
            <span class="toolbar-sep"></span>
            <button type="button" class="toolbar-btn tb-disabled" aria-label="Vistas" title="Vistas">
              <img src="/icons/toolbar/views.png" alt="" /><span>Vistas</span>
            </button>
          </div>
          <div class="explorer-command-bar">
            <div class="field-row explorer-toolbar">
              <label for="explorer-address">Dirección</label>
              <input id="explorer-address" type="text" value="C:\PIXEL\ARTICULOS" spellcheck="false" />
              <button type="button" id="explorer-go">Ir</button>
            </div>
          </div>
          <div class="explorer-body">
            <aside class="explorer-sidebar">
              <div class="explorer-sidebar-header">
                <span>Carpetas</span>
              </div>
              <div class="explorer-tree-panel">
                <ul class="tree-view folder-tree">
                  <li>
                    <span class="tree-root"><span class="tree-toggle">−</span><img src={iconUrls.desktop.computer} alt="" />Mi bitmag</span>
                    <ul>
                      <li>
                        <span class="tree-root"><span class="tree-toggle">−</span><img src={iconUrls.files.folder} alt="" />C:\PIXEL</span>
                        <ul>
                          <li><button class="tree-button" data-folder-nav="all"><img src="/icons/react95/folder-closed-16.png" alt="" />Artículos</button><ul class="tree-files" id="tree-files-all"></ul></li>
                          <li><button class="tree-button" data-folder-nav="entrevista"><img src="/icons/react95/folder-closed-16.png" alt="" />Entrevistas</button><ul class="tree-files" id="tree-files-entrevista"></ul></li>
                          <li><button class="tree-button" data-folder-nav="videos"><img src={iconUrls.files.video} alt="" />Vídeos</button><ul class="tree-files" id="tree-files-videos"></ul></li>
                          <li><button class="tree-button" data-folder-nav="musica"><img src={iconUrls.files.music} alt="" />Música</button><ul class="tree-files" id="tree-files-musica"></ul></li>
                        </ul>
                      </li>
                    </ul>
                  </li>
                </ul>
              </div>
            </aside>
            <div class="explorer-vsplit"></div>
            <div class="explorer-main">
              <div class="sunken-panel file-panel">
                <table class="interactive file-table">
                  <thead><tr><th>Nombre</th><th>Fecha</th><th>Tipo</th><th>Notas</th></tr></thead>
                  <tbody id="file-view"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div class="status-bar"><p class="status-bar-field" id="status-count">0 objetos</p><p class="status-bar-field" id="status-path">C:\PIXEL\ARTICULOS</p><p class="status-bar-field">bitOS 26</p></div>
      </section>

      <div id="reader-windows"></div>

      <section class="window os-window about-window no-resize" id="window-about" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.computer} alt="" /><span>Acerca de bitOS</span></div><div class="title-bar-controls"><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body about-content">
          <img class="about-logo" src="/bitoslogovert.png" alt="bitOS" />
          <p><strong>bitMAG</strong> es un blog de videojuegos donde prima la lectura pausada, el slow gaming y la crítica honesta. Artículos hechos para durar, envueltos en una interfaz que recuerda a los sistemas operativos del pasado.</p>
          <hr />
          <dl>
            <dt>Versión</dt><dd>bitOS 26</dd>
            <dt>Artículos</dt><dd>{posts.length} cargados</dd>
            <dt>Motor</dt><dd>Astro + 98.css</dd>
          </dl>
          <p class="about-hint">Consejo: algunos sistemas responden a secuencias de teclado antiguas.</p>
        </div>
      </section>

      <section class="window os-window settings-window" id="window-settings" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.settings} alt="" /><span>Propiedades de pantalla</span></div><div class="title-bar-controls"><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body settings-content">
          <div class="settings-tabs">
            <button class="settings-tab active" data-tab="fondo">Fondo</button>
            <button class="settings-tab" data-tab="colores">Colores</button>
            <button class="settings-tab" data-tab="efectos">Efectos</button>
            <button class="settings-tab" data-tab="protector">Protector</button>
          </div>
          <div class="settings-tab-body">
            <div class="settings-panel active" id="stab-fondo">
              <fieldset>
                <legend>Fondo del escritorio</legend>
                <div class="wallpaper-options">
                  <button data-wallpaper="teal"><span class="wallpaper-preview teal"></span>Clásico</button>
                  <button data-wallpaper="navy"><span class="wallpaper-preview navy"></span>Azul</button>
                  <button data-wallpaper="black"><span class="wallpaper-preview black"></span>Negro</button>
                  <button data-wallpaper="slate"><span class="wallpaper-preview slate"></span>Pizarra</button>
                  <button data-wallpaper="plum"><span class="wallpaper-preview plum"></span>Ciruela</button>
                  <button data-wallpaper="lavender"><span class="wallpaper-preview lavender"></span>Lavanda</button>
                  <button data-wallpaper="sage"><span class="wallpaper-preview sage"></span>Salvia</button>
                  <button data-wallpaper="terra"><span class="wallpaper-preview terra"></span>Terracota</button>
                  <button data-wallpaper="rose"><span class="wallpaper-preview rose"></span>Rosa</button>
                  <button data-wallpaper="sand"><span class="wallpaper-preview sand"></span>Arena</button>
                  <button data-wallpaper="cream"><span class="wallpaper-preview cream"></span>Crema</button>
                  <button data-wallpaper="rosedk"><span class="wallpaper-preview rosedk"></span>Rosa oscuro</button>
                  <button data-wallpaper="segasky"><span class="wallpaper-preview segasky"></span>Sega Sky</button>
                  <button data-wallpaper="streetsofrage"><span class="wallpaper-preview streetsofrage"></span>Streets of Rage</button>
                  <button data-wallpaper="grid"><span class="wallpaper-preview grid"></span>Cuadrícula</button>
                </div>
              </fieldset>
            </div>
            <div class="settings-panel" id="stab-colores">
              <fieldset>
                <legend>Color de ventanas</legend>
                <div class="wallpaper-options">
                  <button data-wincolor="#000080"><span class="wallpaper-preview" style="background:#000080"></span>Clásico</button>
                  <button data-wincolor="#1a3a5c"><span class="wallpaper-preview" style="background:#1a3a5c"></span>Marino</button>
                  <button data-wincolor="#1a1a18"><span class="wallpaper-preview" style="background:#1a1a18"></span>Negro</button>
                  <button data-wincolor="#3d5a80"><span class="wallpaper-preview" style="background:#3d5a80"></span>Pizarra</button>
                  <button data-wincolor="#4e2d4e"><span class="wallpaper-preview" style="background:#4e2d4e"></span>Ciruela</button>
                  <button data-wincolor="#6a5a8a"><span class="wallpaper-preview" style="background:#6a5a8a"></span>Lavanda</button>
                  <button data-wincolor="#4a7c59"><span class="wallpaper-preview" style="background:#4a7c59"></span>Salvia</button>
                  <button data-wincolor="#8c4a2f"><span class="wallpaper-preview" style="background:#8c4a2f"></span>Terracota</button>
                  <button data-wincolor="#ff66c4"><span class="wallpaper-preview" style="background:#ff66c4"></span>Rosa</button>
                  <button data-wincolor="#7f5a2a"><span class="wallpaper-preview" style="background:#7f5a2a"></span>Arena</button>
                  <button data-wincolor="#7f1d1d"><span class="wallpaper-preview" style="background:#7f1d1d"></span>Granate</button>
                  <button data-wincolor="#d946a8"><span class="wallpaper-preview" style="background:#d946a8"></span>Rosa oscuro</button>
                  <button data-wincolor="#2d6a4f"><span class="wallpaper-preview" style="background:#2d6a4f"></span>Bosque</button>
                </div>
              </fieldset>
            </div>
            <div class="settings-panel" id="stab-efectos">
              <fieldset>
                <legend>Efectos visuales</legend>
                <div class="field-row setting-check"><input type="checkbox" id="crt-toggle" checked /><label for="crt-toggle">Efecto monitor CRT (scanlines, viñeta, parpadeo)</label></div>
              </fieldset>
            </div>
            <div class="settings-panel" id="stab-protector">
              <fieldset>
                <legend>Protector de pantalla</legend>
                <div class="field-row setting-check"><input type="checkbox" id="screensaver-toggle" checked /><label for="screensaver-toggle">Activar salvapantallas tras 45 segundos</label></div>
              </fieldset>
            </div>
          </div>
        </div>
      </section>

      <!-- CRT overlay elements -->
      <div class="crt-overlay" id="crt-overlay"></div>
      <div class="crt-flicker" id="crt-flicker"></div>
      <div class="crt-screen" id="crt-screen"></div>

      <section class="window os-window taisei-window" id="window-taisei" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.taisei} alt="" /><span>Taisei Project</span></div><div class="title-bar-controls"><button aria-label="Minimize" data-action="minimize" data-minimize></button><button aria-label="Maximize" data-action="maximize" data-maximize></button><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body taisei-body">
          <iframe id="taisei-frame" title="Taisei Project" src="" allowfullscreen></iframe>
          <div class="taisei-touch-controls" id="taisei-touch-controls">
            <div class="taisei-joy-zone" id="taisei-joy-zone">
              <div class="taisei-joy-base" id="taisei-joy-base">
                <div class="taisei-joy-knob" id="taisei-joy-knob"></div>
              </div>
            </div>
            <div class="taisei-btns">
              <div class="taisei-btns-row">
                <button class="taisei-btn taisei-btn-focus" id="taisei-btn-focus">Focus</button>
                <button class="taisei-btn taisei-btn-bomb" id="taisei-btn-bomb">Bomb</button>
              </div>
              <button class="taisei-btn taisei-btn-shot" id="taisei-btn-shot">Shot</button>
            </div>
          </div>
        </div>
      </section>

      <section class="window os-window doom-window" id="window-doom" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.doom} alt="" /><span>DOOM</span></div><div class="title-bar-controls"><button aria-label="Minimize" data-action="minimize" data-minimize></button><button aria-label="Maximize" data-action="maximize" data-maximize></button><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body doom-body">
          <iframe id="doom-frame" title="DOOM" src="" allowfullscreen></iframe>
        </div>
      </section>

      <section class="window os-window mplayer-window" id="window-mplayer" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src="/icons/mplayer2-16.png" alt="" /><span id="mplayer-title">Reproductor de Media</span></div><div class="title-bar-controls"><button aria-label="Minimize" data-action="minimize" data-minimize></button><button aria-label="Maximize" data-action="maximize" data-maximize></button><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body mplayer-body">
          <div class="mplayer-menu-bar">
            <button type="button">Archivo</button>
            <button type="button">Ver</button>
            <button type="button">Reproducción</button>
            <button type="button">Favoritos</button>
            <button type="button">Ir</button>
            <button type="button">Ayuda</button>
          </div>
          <div class="mplayer-nav-bar">
            <button class="mp-nav-arrow" id="mp-back" title="Atrás" disabled><svg width="15" height="13" viewBox="0 0 15 13"><path d="M7 0 L0 6.5 L7 13 L7 9 L15 9 L15 4 L7 4 Z" fill="currentColor"/></svg></button>
            <button class="mp-nav-arrow" id="mp-forward" title="Adelante" disabled><svg width="15" height="13" viewBox="0 0 15 13"><path d="M8 0 L15 6.5 L8 13 L8 9 L0 9 L0 4 L8 4 Z" fill="currentColor"/></svg></button>
            <div class="mp-nav-sep"></div>
            <button class="mp-nav-link"><img src="/icons/wmp-radio-16.png" alt="" /> Radio</button>
            <button class="mp-nav-link"><img src="/icons/wmp-music-16.png" alt="" /> Music</button>
            <button class="mp-nav-link"><img src="/icons/wmp-mediaguide-16.png" alt="" /> Media Guide</button>
          </div>
          <div class="mplayer-viewport">
            <video id="mplayer-video" preload="metadata" playsinline webkit-playsinline></video>
          </div>
          <div class="mplayer-bottom">
            <div class="mplayer-seek-row">
              <button class="mp-minibtn" title="Miniplayer"><span class="mpi mpi-mini"></span></button>
              <input type="range" id="mplayer-seek" min="0" max="1000" value="0" class="mplayer-seek" />
            </div>
            <div class="mplayer-controls">
              <div class="mplayer-transport">
                <button id="mp-play" class="mp-btn" title="Reproducir"><span class="mpi mpi-play"></span></button>
                <button id="mp-pause" class="mp-btn" title="Pausa"><span class="mpi mpi-pause"></span></button>
                <button id="mp-stop" class="mp-btn" title="Detener"><span class="mpi mpi-stop"></span></button>
                <span class="mplayer-sep"></span>
                <button id="mp-prev" class="mp-btn" title="Inicio"><span class="mpi mpi-prev"></span></button>
                <button id="mp-rew" class="mp-btn" title="Retroceder"><span class="mpi mpi-rew"></span></button>
                <button id="mp-fwd" class="mp-btn" title="Avanzar"><span class="mpi mpi-fwd"></span></button>
                <button id="mp-next" class="mp-btn" title="Final"><span class="mpi mpi-next"></span></button>
                <span class="mplayer-sep"></span>
                <button class="mp-btn" title="Ecualizador"><span class="mpi mpi-eq"></span></button>
              </div>
              <div class="mplayer-vol-row">
                <span class="mplayer-sep"></span>
                <button id="mp-mute" class="mp-btn mp-vol-icon-btn" title="Silencio"><img id="mp-vol-icon" src="/icons/speaker-16.png" alt="" /></button>
                <div class="mp-vol-wedge-wrap">
                  <div class="mp-vol-wedge"></div>
                  <input type="range" id="mp-volume" min="0" max="100" value="80" class="mplayer-vol" title="Volumen" />
                </div>
              </div>
            </div>
            <div class="mplayer-clip-row">
              <select class="mp-clip-select" id="mp-clip-select">
                <option id="mp-clip-option">—</option>
              </select>
            </div>
            <div class="mplayer-info">
              <div><span class="mp-info-label">Mostrar:</span> <span id="mp-info-show"></span></div>
              <div><span class="mp-info-label">Clip:</span> <span id="mp-info-clip"></span></div>
              <div><span class="mp-info-label">Autor:</span> <span id="mp-info-author"></span></div>
              <div><span class="mp-info-label">Copyright:</span> <span id="mp-info-copy"></span></div>
            </div>
            <div class="mplayer-status-bar">
              <span id="mp-status">Listo</span>
              <span id="mp-time">0:00 / 0:00</span>
            </div>
          </div>
        </div>
      </section>

      <section class="window os-window game-window" id="window-game" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.arcade} alt="" /><span>PIXEL QUEST.EXE</span></div><div class="title-bar-controls"><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body game-content">
          <div class="game-stats">PIXELS: <span id="game-score">0</span>/5</div>
          <div id="game-board" class="game-board" aria-label="Minijuego Pixel Quest"></div>
          <p id="game-message">Recoge los cinco píxeles rojos. Usa las flechas.</p>
          <div class="touch-dpad"><button data-move="up">▲</button><div><button data-move="left">◀</button><button data-move="down">▼</button><button data-move="right">▶</button></div></div>
        </div>
      </section>

    </main>

    <div id="webamp-container"></div>

    <template id="reader-template">
      <section class="window os-window reader-window">
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.files.article} alt="" /><span>Lector de PIXEL</span></div><div class="title-bar-controls"><button aria-label="Minimize" data-action="minimize" data-minimize></button><button aria-label="Maximize" data-action="maximize" data-maximize></button><button aria-label="Close" data-action="close" class="close" data-close></button></div></div>
        <div class="window-body ie3-body">
          <div class="ie3-menubar" role="menubar">
            <button class="ie3-menubar-button" type="button"><u>A</u>rchivo</button>
            <button class="ie3-menubar-button" type="button"><u>E</u>dición</button>
            <button class="ie3-menubar-button" type="button"><u>V</u>er</button>
            <button class="ie3-menubar-button" type="button">I<u>r</u></button>
