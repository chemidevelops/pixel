---
import '98.css/dist/98.css';
interface PostFile {
  id: string;
  title: string;
  date: string;
  excerpt: string;
  tags: string[];
  issue?: number;
}

interface IssueFile {
  number: number;
  title: string;
  date: string;
  pdf?: string;
  pdfPrint?: string;
}

interface Props {
  posts: PostFile[];
  issues: IssueFile[];
}

const { posts, issues } = Astro.props;
const iconUrls = {
  desktop: {
    folder: '/icons/react95/folder-32.png',
    interview: '/icons/react95/notepad-32.png',
    arcade: '/icons/react95/exe-32.png',
    fanzines: '/icons/react95/notepad-32.png',
    computer: '/icons/react95/computer-32.png',
    settings: '/icons/react95/settings-32.png',
  },
  files: {
    article: '/icons/react95/html-16.png',
    pdf: '/icons/react95/file-32.png',
    folder: '/icons/react95/folder-16.png',
    window: '/icons/react95/explorer-16.png',
  },
};
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="description" content="PIXEL — revista independiente de videojuegos" />
  <title>PixelOS — PIXEL</title>
  <link rel="stylesheet" href="/styles/pixelos.css" />
</head>
<body>
  <div id="pixel-os" class="pixel-os wallpaper-teal">
    <header class="mobile-status">
      <button class="mobile-start" type="button">Start</button>
      <strong>PixelOS Mobile</strong>
      <div class="mobile-status-meta">
        <span class="mobile-signal" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="mobile-battery" aria-hidden="true"></span>
        <time id="mobile-clock">00:00</time>
      </div>
    </header>

    <main class="desktop" aria-label="Escritorio PixelOS">
      <div class="desktop-selection-box" id="desktop-selection-box" hidden></div>
      <ul class="desktop-icons">
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-folder="all"><img class="desktop-icon-image" src={iconUrls.desktop.folder} alt="" /><div class="border-box"><p class="desktop-icon-label">Artículos</p></div></button></li>
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-folder="arcade"><img class="desktop-icon-image" src={iconUrls.desktop.arcade} alt="" /><div class="border-box"><p class="desktop-icon-label">Arcade</p></div></button></li>
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-folder="fanzines"><img class="desktop-icon-image" src={iconUrls.desktop.fanzines} alt="" /><div class="border-box"><p class="desktop-icon-label">Fanzines</p></div></button></li>
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-window="about"><img class="desktop-icon-image" src={iconUrls.desktop.computer} alt="" /><div class="border-box"><p class="desktop-icon-label">Mi Pixel</p></div></button></li>
        <li class="desktop-icon-item"><button class="desktop-icon" data-desktop-window="settings"><img class="desktop-icon-image" src={iconUrls.desktop.settings} alt="" /><div class="border-box"><p class="desktop-icon-label">Panel de control</p></div></button></li>
      </ul>

      <section class="mobile-launcher" aria-label="Explorador">
        <div class="mobile-today-header"><strong>Hoy</strong><span>Mi dispositivo</span></div>
        <div class="mobile-welcome"><div><span class="pixel-logo">PixelOS 95</span><p>Explorador móvil estilo Pocket PC</p></div><span class="mobile-date-badge">PIXEL</span></div>
        <div class="pda-address"><span>\Mi dispositivo\Pixel</span><button type="button">▼</button></div>
        <div class="mobile-folder-list">
          <button data-folder="all"><span class="mini-folder"></span><span><strong>Artículos</strong><small>Lista de archivos HTML</small></span></button>
          <button data-folder="entrevista"><span class="mini-folder"></span><span><strong>Entrevistas</strong><small>Conversaciones y perfiles</small></span></button>
          <button data-folder="arcade"><span class="mini-folder"></span><span><strong>Arcade</strong><small>Críticas, acción y clásicos</small></span></button>
          <button data-folder="fanzines"><span class="mini-folder"></span><span><strong>Fanzines</strong><small>PDF descargable</small></span></button>
          <button data-window="about"><span class="mobile-file-icon">TXT</span><span><strong>Acerca de PixelOS</strong><small>Información del sistema</small></span></button>
        </div>
        <div class="pda-status">{posts.length + issues.length} objetos</div>
        <div class="mobile-softkeys"><button type="button" data-folder="all">Explorar</button><button type="button" data-window="settings">Menú</button></div>
      </section>

      <section class="window os-window explorer-window" id="window-explorer" hidden>
        <div class="title-bar">
          <div class="title-bar-text"><img class="window-title-icon" src={iconUrls.files.window} alt="" /><span id="explorer-title">Artículos</span></div>
          <div class="title-bar-controls"><button aria-label="Minimize" data-minimize></button><button aria-label="Close" class="close" data-close></button></div>
        </div>
        <div class="window-body explorer-shell">
          <div class="explorer-menu-bar" role="menubar" aria-label="Menú del explorador">
            <button type="button">Archivo</button>
            <button type="button">Edición</button>
            <button type="button">Ver</button>
            <button type="button">Ir</button>
            <button type="button">Favoritos</button>
            <button type="button">Ayuda</button>
          </div>
          <div class="explorer-command-bar">
            <div class="explorer-nav-buttons">
              <button type="button" id="explorer-back" aria-label="Atrás">◀</button>
              <button type="button" id="explorer-up" aria-label="Subir">▲</button>
            </div>
            <div class="field-row explorer-toolbar">
              <label for="explorer-address">Dirección</label>
              <input id="explorer-address" type="text" value="C:\PIXEL\ARTICULOS" spellcheck="false" />
              <button type="button" id="explorer-go">Ir</button>
            </div>
          </div>
          <div class="explorer-body">
            <aside class="explorer-sidebar">
              <div class="sunken-panel explorer-tree-panel">
                <ul class="tree-view folder-tree">
                  <li>
                    <span class="tree-root"><span class="tree-toggle">−</span><img src={iconUrls.desktop.computer} alt="" />Mi Pixel</span>
                    <ul>
                      <li>
                        <span class="tree-root"><span class="tree-toggle">−</span><img src={iconUrls.files.folder} alt="" />C:\PIXEL</span>
                        <ul>
                          <li><button class="tree-button active" data-folder-nav="all"><img src={iconUrls.files.folder} alt="" />Artículos</button></li>
                          <li><button class="tree-button" data-folder-nav="entrevista"><img src={iconUrls.files.folder} alt="" />Entrevistas</button></li>
                          <li><button class="tree-button" data-folder-nav="arcade"><img src={iconUrls.files.folder} alt="" />Arcade</button></li>
                        </ul>
                      </li>
                      <li><button class="tree-button" data-folder-nav="fanzines"><img src={iconUrls.files.folder} alt="" />Disco de 3½ (A:)</button></li>
                    </ul>
                  </li>
                </ul>
              </div>
            </aside>
            <div class="explorer-main">
              <div class="sunken-panel file-panel">
                <table class="interactive file-table">
                  <thead><tr><th>Nombre</th><th>Fecha</th><th>Tipo</th><th>Notas</th></tr></thead>
                  <tbody id="file-view"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
        <div class="status-bar"><p class="status-bar-field" id="status-count">0 objetos</p><p class="status-bar-field" id="status-path">C:\PIXEL\ARTICULOS</p><p class="status-bar-field">PixelOS 95</p></div>
      </section>

      <div id="reader-windows"></div>

      <section class="window os-window about-window" id="window-about" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.computer} alt="" /><span>Acerca de PixelOS</span></div><div class="title-bar-controls"><button aria-label="Close" class="close" data-close></button></div></div>
        <div class="window-body about-content">
          <div class="about-logo">PIXEL<span>.</span></div>
          <h1>PixelOS 95</h1>
          <p>Una revista independiente de videojuegos convertida en sistema operativo.</p>
          <hr />
          <dl><dt>Versión</dt><dd>0.1 Experimental</dd><dt>Memoria</dt><dd>{posts.length} artículos cargados</dd><dt>Formato</dt><dd>HTML, papel y secretos</dd></dl>
          <p class="about-hint">Consejo: algunos sistemas responden a secuencias de teclado antiguas.</p>
        </div>
      </section>

      <section class="window os-window settings-window" id="window-settings" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.settings} alt="" /><span>Propiedades de pantalla</span></div><div class="title-bar-controls"><button aria-label="Close" class="close" data-close></button></div></div>
        <div class="window-body settings-content">
          <fieldset>
            <legend>Fondo del escritorio</legend>
            <div class="wallpaper-options">
              <button data-wallpaper="teal"><span class="wallpaper-preview teal"></span>Clásico</button>
              <button data-wallpaper="grid"><span class="wallpaper-preview grid"></span>Cuadrícula</button>
            </div>
          </fieldset>
          <div class="field-row setting-check"><input type="checkbox" id="screensaver-toggle" checked /><label for="screensaver-toggle">Activar salvapantallas tras 45 segundos</label></div>
        </div>
      </section>

      <section class="window os-window game-window" id="window-game" hidden>
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.desktop.arcade} alt="" /><span>PIXEL QUEST.EXE</span></div><div class="title-bar-controls"><button aria-label="Close" class="close" data-close></button></div></div>
        <div class="window-body game-content">
          <div class="game-stats">PIXELS: <span id="game-score">0</span>/5</div>
          <div id="game-board" class="game-board" aria-label="Minijuego Pixel Quest"></div>
          <p id="game-message">Recoge los cinco píxeles rojos. Usa las flechas.</p>
          <div class="touch-dpad"><button data-move="up">▲</button><div><button data-move="left">◀</button><button data-move="down">▼</button><button data-move="right">▶</button></div></div>
        </div>
      </section>
    </main>

    <div class="start-menu" id="start-menu" hidden>
      <div class="start-brand">PixelOS <b>95</b></div>
      <div class="start-items">
        <button class="start-entry" data-folder="all"><img class="menu-icon" src={iconUrls.desktop.folder} alt="" /><span>Artículos</span></button>
        <button class="start-entry" data-folder="fanzines"><img class="menu-icon" src={iconUrls.desktop.fanzines} alt="" /><span>Fanzines</span></button>
        <button class="start-entry" data-window="settings"><img class="menu-icon" src={iconUrls.desktop.settings} alt="" /><span>Configuración</span></button>
        <button class="start-entry" data-window="about"><img class="menu-icon" src={iconUrls.desktop.computer} alt="" /><span>Acerca de...</span></button>
        <div class="start-divider" aria-hidden="true"></div>
        <button class="start-entry" id="shutdown"><img class="menu-icon" src={iconUrls.desktop.computer} alt="" /><span>Apagar...</span></button>
      </div>
    </div>

    <footer class="taskbar">
      <button class="start-button" id="start-button">Inicio</button>
      <div class="task-buttons" id="task-buttons"></div>
      <div class="tray">
        <img src="/icons/volume-2.ico" alt="" class="tray-icon" />
        <button class="tray-clock" id="tray-clock">00:00</button>
      </div>
    </footer>

    <div class="screensaver" id="screensaver" hidden><canvas id="maze-screensaver" width="320" height="200" aria-label="Salvapantallas de laberinto 3D"></canvas><small>Mueve el ratón o pulsa una tecla</small></div>
    <div class="shutdown-screen" id="shutdown-screen" hidden><strong>Ahora puede apagar su revista.</strong><button id="restart">Reiniciar PixelOS</button></div>

    <template id="reader-template">
      <section class="window os-window reader-window">
        <div class="title-bar"><div class="title-bar-text"><img class="window-title-icon" src={iconUrls.files.article} alt="" /><span>Lector de PIXEL</span></div><div class="title-bar-controls"><button aria-label="Minimize" data-minimize></button><button aria-label="Maximize" data-maximize></button><button aria-label="Close" class="close" data-close></button></div></div>
        <div class="window-body reader-body">
          <div class="reader-caption" data-reader-path>pixel://articulo</div>
          <iframe title="Artículo de PIXEL"></iframe>
        </div>
      </section>
    </template>
  </div>

  <script define:vars={{ posts, issues, iconUrls }}>
    const os = document.getElementById('pixel-os');
    const desktop = document.querySelector('.desktop');
    const desktopSelectionBox = document.getElementById('desktop-selection-box');
    const explorer = document.getElementById('window-explorer');
    const fileView = document.getElementById('file-view');
    const taskButtons = document.getElementById('task-buttons');
    const startMenu = document.getElementById('start-menu');
    const readerWindows = document.getElementById('reader-windows');
    const readerTemplate = document.getElementById('reader-template');
    const mazeCanvas = document.getElementById('maze-screensaver');
    const folderTitles = {
      all: ['Artículos', 'C:\\PIXEL\\ARTICULOS'],
      entrevista: ['Entrevistas', 'C:\\PIXEL\\ENTREVISTAS'],
      arcade: ['Arcade', 'C:\\PIXEL\\ARCADE'],
      fanzines: ['Fanzines', 'A:\\FANZINES'],
    };
    const folderAliases = {
      'C:\\PIXEL\\ARTICULOS': 'all',
      'C:\\PIXEL\\ENTREVISTAS': 'entrevista',
      'C:\\PIXEL\\ARCADE': 'arcade',
      'A:\\FANZINES': 'fanzines',
      'ARTICULOS': 'all',
      'ENTREVISTAS': 'entrevista',
      'ARCADE': 'arcade',
      'FANZINES': 'fanzines',
    };
    let topZ = 20;
    let readerOffset = 0;
    let currentFolder = 'all';
    const folderHistory = ['all'];
    let historyIndex = 0;
    let openingQueue = 0;

    function pause(ms) {
      return new Promise(function(resolve) { setTimeout(resolve, ms); });
    }

    async function withOpeningFeedback(action) {
      openingQueue += 1;
      document.body.classList.add('opening-wait');
      try {
        await pause(140);
        return action();
      } finally {
        openingQueue -= 1;
        if (openingQueue <= 0) {
          openingQueue = 0;
          document.body.classList.remove('opening-wait');
        }
      }
    }

    function allWindows() {
      return Array.from(document.querySelectorAll('.os-window'));
    }

    function showWindowNow(id) {
      const win = document.getElementById('window-' + id);
      if (!win) return;
      win.hidden = false;
      win.classList.remove('minimized');
      focusWindow(win);
      syncTasks();
      startMenu.hidden = true;
    }

    function showWindow(id) {
      return withOpeningFeedback(function() { showWindowNow(id); });
    }

    function focusWindow(win) {
      topZ += 1;
      win.style.zIndex = String(topZ);
      allWindows().forEach(function(item) { item.classList.toggle('focused', item === win); });
    }

    function closeWindow(win) {
      win.hidden = true;
      win.classList.remove('maximized', 'minimized');
      syncTasks();
    }

    function syncTasks() {
      taskButtons.innerHTML = '';
      allWindows().filter(function(win) { return !win.hidden; }).forEach(function(win) {
        const button = document.createElement('button');
        const sourceIcon = win.querySelector('.window-title-icon');
        if (sourceIcon) {
          const icon = document.createElement('img');
          icon.src = sourceIcon.src;
          icon.alt = '';
          button.appendChild(icon);
        }
        const label = document.createElement('span');
        label.textContent = (win.querySelector('.title-bar-text span') || {}).textContent || 'Ventana';
        button.appendChild(label);
        button.className = win.classList.contains('minimized') ? '' : 'active';
        button.addEventListener('click', function() {
          if (win.classList.contains('minimized')) {
            win.classList.remove('minimized');
            focusWindow(win);
          } else if (win.classList.contains('focused')) {
            win.classList.add('minimized');
          } else {
            focusWindow(win);
          }
          syncTasks();
        });
        taskButtons.appendChild(button);
      });
    }

    function filesFor(folder) {
      if (folder === 'all') return posts;
      if (folder === 'entrevista') return posts.filter(function(post) { return post.tags.includes('entrevista'); });
      if (folder === 'arcade') return posts.filter(function(post) { return post.tags.some(function(tag) { return ['arcade', 'acción', 'clásicos'].includes(tag); }); });
      return [];
    }

    function selectRow(row) {
      fileView.querySelectorAll('tr').forEach(function(item) { item.classList.remove('highlighted'); });
      row.classList.add('highlighted');
    }

    function resolveFolderPath(value) {
      const normalized = String(value || '').trim().replace(/\//g, '\\').toUpperCase();
      return folderAliases[normalized] || null;
    }

    function openFolderNow(folder, options) {
      options = options || {};
      const titleAndPath = folderTitles[folder];
      if (!titleAndPath) return;
      const title = titleAndPath[0];
      const path = titleAndPath[1];
      currentFolder = folder;
      document.getElementById('explorer-title').textContent = title;
      document.getElementById('explorer-address').value = path;
      document.getElementById('status-path').textContent = path;
      fileView.innerHTML = '';
      document.querySelectorAll('[data-folder-nav]').forEach(function(item) { item.classList.toggle('active', item.dataset.folderNav === folder); });
      document.getElementById('explorer-up').disabled = folder === 'all';
      if (folder === 'fanzines') {
        issues.forEach(function(issue) {
          if (issue.pdf) fileView.appendChild(makeDownloadFile(issue, false));
          if (issue.pdfPrint) fileView.appendChild(makeDownloadFile(issue, true));
        });
      } else {
        const files = filesFor(folder);
        files.forEach(function(post) { fileView.appendChild(makeArticleFile(post)); });
      }
      document.getElementById('status-count').textContent = String(fileView.children.length) + ' objetos';
      if (!options.skipHistory) {
        folderHistory.splice(historyIndex + 1);
        folderHistory.push(folder);
        historyIndex = folderHistory.length - 1;
      }
      document.getElementById('explorer-back').disabled = historyIndex === 0;
      showWindowNow('explorer');
    }

    function openFolder(folder, options) {
      return withOpeningFeedback(function() { openFolderNow(folder, options); });
    }

    function makeArticleFile(post) {
      const row = document.createElement('tr');
      row.className = 'file-item';
      row.tabIndex = 0;
      row.innerHTML = '<td class="name-cell"><img class="file-type-icon" src="' + iconUrls.files.article + '" alt="" /><span class="file-main"><strong>' + post.title + '</strong></span></td><td>' + formatDate(post.date) + '</td><td>Documento HTML</td><td>' + ((post.tags.slice(0, 2).join(' · ')) || 'PIXEL') + '</td>';
      row.addEventListener('dblclick', function() { openArticle(post); });
      row.addEventListener('click', function() {
        if (matchMedia('(max-width: 700px)').matches) {
          openArticle(post);
          return;
        }
        selectRow(row);
      });
      row.addEventListener('keydown', function(event) { if (event.key === 'Enter') openArticle(post); });
      return row;
    }

    function makeDownloadFile(issue, print) {
      const row = document.createElement('tr');
      const href = print ? issue.pdfPrint : issue.pdf;
      row.className = 'file-item';
      row.tabIndex = 0;
      row.innerHTML = '<td class="name-cell"><img class="file-type-icon" src="' + iconUrls.files.pdf + '" alt="" /><span class="file-main"><strong>' + issue.title + (print ? ' — Imprimir' : '') + '</strong></span></td><td>' + issue.date + '</td><td>Adobe PDF</td><td>Descarga</td>';
      function triggerDownload() {
        const link = document.createElement('a');
        link.href = href;
        link.download = '';
        link.click();
      }
      row.addEventListener('dblclick', triggerDownload);
      row.addEventListener('click', function() {
        if (matchMedia('(max-width: 700px)').matches) {
          triggerDownload();
          return;
        }
        selectRow(row);
      });
      row.addEventListener('keydown', function(event) { if (event.key === 'Enter') triggerDownload(); });
      return row;
    }

    function openArticleNow(post) {
      const url = '/pixelos/posts/' + post.id;
      const existing = document.querySelector('[data-reader-id="' + CSS.escape(post.id) + '"]');
      if (existing) {
        existing.classList.remove('minimized');
        focusWindow(existing);
        syncTasks();
        return;
      }
      const win = readerTemplate.content.firstElementChild.cloneNode(true);
      win.dataset.readerId = post.id;
      win.querySelector('.title-bar-text span').textContent = post.title;
      win.querySelector('[data-reader-path]').textContent = 'C:\\PIXEL\\ARTICULOS\\' + post.id + '.HTM';
      win.querySelector('iframe').src = url;
      if (!matchMedia('(max-width: 700px)').matches) {
        win.style.left = String(210 + (readerOffset % 7) * 30) + 'px';
        win.style.top = String(55 + (readerOffset % 7) * 24) + 'px';
        readerOffset += 1;
      }
      readerWindows.appendChild(win);
      bindWindow(win);
      focusWindow(win);
      syncTasks();
    }

    function openArticle(post) {
      return withOpeningFeedback(function() { openArticleNow(post); });
    }

    function formatDate(date) {
      return new Date(date).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    document.querySelectorAll('[data-folder]').forEach(function(button) { button.addEventListener('click', function() { openFolder(button.dataset.folder); }); });
    document.querySelectorAll('[data-folder-nav]').forEach(function(button) { button.addEventListener('click', function() { openFolder(button.dataset.folderNav); }); });
    document.querySelectorAll('[data-window]').forEach(function(button) { button.addEventListener('click', function() { showWindow(button.dataset.window); }); });
    document.getElementById('explorer-go').addEventListener('click', function() {
      const targetFolder = resolveFolderPath(document.getElementById('explorer-address').value);
      if (targetFolder) openFolder(targetFolder);
      else document.getElementById('explorer-address').value = folderTitles[currentFolder][1];
    });
    document.getElementById('explorer-address').addEventListener('keydown', function(event) {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      document.getElementById('explorer-go').click();
    });
    document.getElementById('explorer-back').addEventListener('click', function() {
      if (historyIndex === 0) return;
      historyIndex -= 1;
      openFolder(folderHistory[historyIndex], { skipHistory: true });
    });
    document.getElementById('explorer-up').addEventListener('click', function() {
      if (currentFolder === 'all') return;
      openFolder('all');
    });
    function desktopButtons() {
      return Array.from(document.querySelectorAll('.desktop-icon'));
    }
    function clearDesktopSelection() {
      desktopButtons().forEach(function(button) { button.classList.remove('selected'); });
    }
    function selectDesktopButton(button, additive) {
      if (!additive) clearDesktopSelection();
      button.classList.add('selected');
      button.focus();
    }
    function openDesktopButton(button) {
      if (button.dataset.desktopFolder) openFolder(button.dataset.desktopFolder);
      if (button.dataset.desktopWindow) showWindow(button.dataset.desktopWindow);
    }
    let lastDesktopClick = { button: null, time: 0 };

    function bindWindow(win) {
      win.querySelectorAll('[data-close]').forEach(function(button) { button.addEventListener('click', function() { closeWindow(win); if (win.dataset.readerId) win.remove(); }); });
      win.querySelectorAll('[data-minimize]').forEach(function(button) { button.addEventListener('click', function() { win.classList.add('minimized'); syncTasks(); }); });
      win.querySelectorAll('[data-maximize]').forEach(function(button) { button.addEventListener('click', function() { win.classList.toggle('maximized'); }); });
      win.addEventListener('pointerdown', function() { focusWindow(win); });
      if (matchMedia('(max-width: 700px)').matches) return;
      const bar = win.querySelector('.title-bar');
      let dragging = false;
      let offsetX = 0;
      let offsetY = 0;
      bar.addEventListener('pointerdown', function(event) {
        if (event.target.closest('button')) return;
        if (win.classList.contains('maximized')) {
          const width = Math.min(980, window.innerWidth - 220);
          win.classList.remove('maximized');
          win.style.width = width + 'px';
          win.style.height = Math.min(650, window.innerHeight - 110) + 'px';
          win.style.left = Math.max(0, event.clientX - width / 2) + 'px';
          win.style.top = '24px';
        }
        dragging = true;
        offsetX = event.clientX - win.offsetLeft;
        offsetY = event.clientY - win.offsetTop;
        bar.setPointerCapture(event.pointerId);
      });
      bar.addEventListener('pointermove', function(event) {
        if (!dragging) return;
        win.style.left = String(Math.max(0, event.clientX - offsetX)) + 'px';
        win.style.top = String(Math.max(0, event.clientY - offsetY)) + 'px';
      });
      bar.addEventListener('pointerup', function() { dragging = false; });
    }

    allWindows().forEach(bindWindow);
    const desktopGrid = { stepX: 94, stepY: 96, minX: 0, minY: 0 };
    function desktopItems() {
      return Array.from(document.querySelectorAll('.desktop-icon-item'));
    }
    function selectedDesktopItems() {
      return desktopItems().filter(function(item) {
        return item.querySelector('.desktop-icon').classList.contains('selected');
      });
    }
    function slotForPosition(left, top) {
      return {
        col: Math.max(0, Math.round(left / desktopGrid.stepX)),
        row: Math.max(0, Math.round(top / desktopGrid.stepY)),
      };
    }
    function occupiedSlots(exceptItem) {
      const used = new Set();
      desktopItems().forEach(function(node) {
        if (node === exceptItem) return;
        const slot = slotForPosition(node.offsetLeft, node.offsetTop);
        used.add(slot.col + ':' + slot.row);
      });
      return used;
    }
    function findNearestFreeSlot(left, top, exceptItem) {
      const target = slotForPosition(left, top);
      const used = occupiedSlots(exceptItem);
      if (!used.has(target.col + ':' + target.row)) return target;
      for (let radius = 1; radius < 20; radius += 1) {
        for (let row = target.row - radius; row <= target.row + radius; row += 1) {
          for (let col = target.col - radius; col <= target.col + radius; col += 1) {
            if (row < 0 || col < 0) continue;
            const key = col + ':' + row;
            if (!used.has(key)) return { col: col, row: row };
          }
        }
      }
      return target;
    }
    function snapItemsToFreeSlots(items) {
      const selectedSet = new Set(items);
      const occupied = new Set();
      desktopItems().forEach(function(node) {
        if (selectedSet.has(node)) return;
        const slot = slotForPosition(node.offsetLeft, node.offsetTop);
        occupied.add(slot.col + ':' + slot.row);
      });
      items.slice().sort(function(a, b) {
        if (a.offsetTop !== b.offsetTop) return a.offsetTop - b.offsetTop;
        return a.offsetLeft - b.offsetLeft;
      }).forEach(function(item) {
        const target = slotForPosition(item.offsetLeft, item.offsetTop);
        let chosen = target;
        if (occupied.has(target.col + ':' + target.row)) {
          chosen = findNearestFreeSlot(item.offsetLeft, item.offsetTop, item);
          while (occupied.has(chosen.col + ':' + chosen.row)) {
            chosen = { col: chosen.col + 1, row: chosen.row };
          }
        }
        occupied.add(chosen.col + ':' + chosen.row);
        item.style.left = String(chosen.col * desktopGrid.stepX) + 'px';
        item.style.top = String(chosen.row * desktopGrid.stepY) + 'px';
      });
    }
    document.querySelectorAll('.desktop-icon-item').forEach(function(item) {
      if (matchMedia('(max-width: 700px)').matches) return;
      const button = item.querySelector('.desktop-icon');
      let dragging = false;
      let moved = false;
      let startX = 0;
      let startY = 0;
      let draggedItems = [];
      let itemOrigins = new Map();
      item.addEventListener('pointerdown', function(event) {
        if (event.target.closest('.desktop-icon') == null) return;
        if (!button.classList.contains('selected')) selectDesktopButton(button, event.ctrlKey || event.metaKey);
        dragging = true;
        moved = false;
        startX = event.clientX;
        startY = event.clientY;
        draggedItems = selectedDesktopItems();
        if (!draggedItems.length) draggedItems = [item];
        itemOrigins = new Map();
        draggedItems.forEach(function(node) {
          itemOrigins.set(node, { left: node.offsetLeft, top: node.offsetTop });
          node.style.zIndex = '5';
        });
        item.setPointerCapture(event.pointerId);
      });
      item.addEventListener('pointermove', function(event) {
        if (!dragging) return;
        const dx = event.clientX - startX;
        const dy = event.clientY - startY;
        if (Math.abs(dx) > 4 || Math.abs(dy) > 4) moved = true;
        if (!moved) return;
        draggedItems.forEach(function(node) {
          const origin = itemOrigins.get(node);
          node.style.left = String(Math.max(0, origin.left + dx)) + 'px';
          node.style.top = String(Math.max(0, origin.top + dy)) + 'px';
        });
      });
      item.addEventListener('pointerup', function(event) {
        dragging = false;
        if (moved) {
          snapItemsToFreeSlots(draggedItems);
        } else {
          const clickedButton = item.querySelector('.desktop-icon');
          const now = Date.now();
          if (lastDesktopClick.button === clickedButton && now - lastDesktopClick.time < 350) {
            openDesktopButton(clickedButton);
            lastDesktopClick = { button: null, time: 0 };
          } else {
            selectDesktopButton(clickedButton, event.ctrlKey || event.metaKey);
            lastDesktopClick = { button: clickedButton, time: now };
          }
        }
        draggedItems.forEach(function(node) { node.style.zIndex = ''; });
        item.releasePointerCapture(event.pointerId);
      });
      item.addEventListener('pointercancel', function() {
        dragging = false;
        draggedItems.forEach(function(node) { node.style.zIndex = ''; });
      });
    });
    if (!matchMedia('(max-width: 700px)').matches) {
      let boxSelecting = false;
      let boxStartX = 0;
      let boxStartY = 0;
      desktop.addEventListener('pointerdown', function(event) {
        if (event.target.closest('.desktop-icon, .window, .taskbar, .start-menu')) return;
        boxSelecting = true;
        boxStartX = event.clientX;
        boxStartY = event.clientY;
        clearDesktopSelection();
        desktopSelectionBox.hidden = false;
        desktopSelectionBox.style.left = event.clientX + 'px';
        desktopSelectionBox.style.top = event.clientY + 'px';
        desktopSelectionBox.style.width = '0px';
        desktopSelectionBox.style.height = '0px';
      });
      desktop.addEventListener('pointermove', function(event) {
        if (!boxSelecting) return;
        const left = Math.min(boxStartX, event.clientX);
        const top = Math.min(boxStartY, event.clientY);
        const width = Math.abs(event.clientX - boxStartX);
        const height = Math.abs(event.clientY - boxStartY);
        desktopSelectionBox.style.left = left + 'px';
        desktopSelectionBox.style.top = top + 'px';
        desktopSelectionBox.style.width = width + 'px';
        desktopSelectionBox.style.height = height + 'px';
        const box = { left: left, top: top, right: left + width, bottom: top + height };
        desktopButtons().forEach(function(button) {
          const rect = button.getBoundingClientRect();
          const intersects = !(rect.right < box.left || rect.left > box.right || rect.bottom < box.top || rect.top > box.bottom);
          button.classList.toggle('selected', intersects);
        });
      });
      desktop.addEventListener('pointerup', function() {
        if (!boxSelecting) return;
        boxSelecting = false;
        desktopSelectionBox.hidden = true;
      });
      desktop.addEventListener('pointercancel', function() {
        boxSelecting = false;
        desktopSelectionBox.hidden = true;
      });
    }
    document.getElementById('start-button').addEventListener('click', function(event) { event.stopPropagation(); startMenu.hidden = !startMenu.hidden; });
    document.addEventListener('click', function(event) { if (!startMenu.contains(event.target) && event.target.id !== 'start-button') startMenu.hidden = true; });
    document.querySelectorAll('[data-wallpaper]').forEach(function(button) { button.addEventListener('click', function() { os.className = 'pixel-os wallpaper-' + button.dataset.wallpaper; localStorage.setItem('pixelos-wallpaper-v3', button.dataset.wallpaper); }); });
    const savedWallpaper = localStorage.getItem('pixelos-wallpaper-v3');
    if (savedWallpaper) os.className = 'pixel-os wallpaper-' + savedWallpaper;

    const mazeMap = ['111111111111','100000100001','101110101101','101000001001','101011111001','100010000001','111010111101','100010100001','101110101111','100000100001','101111000001','111111111111'];
    const mazeContext = mazeCanvas.getContext('2d', { alpha: false });
    mazeContext.imageSmoothingEnabled = false;
    let mazeFrame = 0;
    let mazeLastTime = 0;
    const mazePlayer = { x: 1.5, y: 1.5, angle: 0 };
    function wallAt(x, y) { const row = mazeMap[Math.floor(y)]; return !row || row[Math.floor(x)] !== '0'; }
    function renderMaze(time) {
      if (screensaver.hidden) { mazeFrame = 0; return; }
      const elapsed = Math.min(0.04, (time - mazeLastTime) / 1000 || 0);
      mazeLastTime = time;
      const speed = matchMedia('(prefers-reduced-motion: reduce)').matches ? 0.08 : 0.55;
      const nextX = mazePlayer.x + Math.cos(mazePlayer.angle) * elapsed * speed;
      const nextY = mazePlayer.y + Math.sin(mazePlayer.angle) * elapsed * speed;
      if (!wallAt(nextX, nextY)) { mazePlayer.x = nextX; mazePlayer.y = nextY; } else { mazePlayer.angle += Math.PI / 2; }
      mazePlayer.angle += Math.sin(time / 2800) * 0.0007;
      const width = mazeCanvas.width;
      const height = mazeCanvas.height;
      mazeContext.fillStyle = '#101018'; mazeContext.fillRect(0, 0, width, height / 2);
      mazeContext.fillStyle = '#4c4c52'; mazeContext.fillRect(0, height / 2, width, height / 2);
      for (let row = height / 2; row < height; row += 4) { const alpha = Math.max(0.02, 0.2 - (row - height / 2) / height * 0.18); mazeContext.fillStyle = 'rgba(255,255,255,' + alpha + ')'; mazeContext.fillRect(0, row, width, 1); }
      for (let column = 0; column < width; column += 2) {
        const rayAngle = mazePlayer.angle - Math.PI / 6 + (column / width) * Math.PI / 3;
        let distance = 0.04;
        while (distance < 14 && !wallAt(mazePlayer.x + Math.cos(rayAngle) * distance, mazePlayer.y + Math.sin(rayAngle) * distance)) distance += 0.035;
        const corrected = distance * Math.cos(rayAngle - mazePlayer.angle);
        const wallHeight = Math.min(height, height / Math.max(0.2, corrected));
        const shade = Math.max(38, 185 - corrected * 15);
        const red = Math.min(220, shade + 35);
        const green = Math.max(40, shade * 0.46);
        const blue = Math.max(30, shade * 0.34);
        mazeContext.fillStyle = 'rgb(' + red + ',' + green + ',' + blue + ')';
        mazeContext.fillRect(column, (height - wallHeight) / 2, 2, wallHeight);
        mazeContext.fillStyle = 'rgba(0,0,0,' + (0.12 + (column % 8 === 0 ? 0.15 : 0)) + ')';
        mazeContext.fillRect(column, (height - wallHeight) / 2, 1, wallHeight);
      }
      mazeFrame = requestAnimationFrame(renderMaze);
    }
    function startMazeScreensaver() { cancelAnimationFrame(mazeFrame); mazeFrame = 0; mazeLastTime = performance.now(); mazeFrame = requestAnimationFrame(renderMaze); }
    allWindows().forEach(function(win, index) { if (matchMedia('(max-width: 700px)').matches) return; win.style.left = String(170 + index * 28) + 'px'; win.style.top = String(70 + index * 24) + 'px'; });
    function updateClock() { const value = new Date().toLocaleTimeString('es-ES', { hour: '2-digit', minute: '2-digit' }); document.getElementById('tray-clock').textContent = value; document.getElementById('mobile-clock').textContent = value; }
    updateClock();
    setInterval(updateClock, 15000);
    const screensaver = document.getElementById('screensaver');
    const saverToggle = document.getElementById('screensaver-toggle');
    let saverTimer;
    function resetSaver() { screensaver.hidden = true; cancelAnimationFrame(mazeFrame); mazeFrame = 0; clearTimeout(saverTimer); if (saverToggle.checked) saverTimer = setTimeout(function() { screensaver.hidden = false; startMazeScreensaver(); }, 45000); }
    ['pointermove', 'pointerdown', 'keydown', 'touchstart'].forEach(function(name) { document.addEventListener(name, resetSaver, { passive: true }); });
    saverToggle.addEventListener('change', resetSaver);
    resetSaver();
    document.getElementById('shutdown').addEventListener('click', function() { document.getElementById('shutdown-screen').hidden = false; });
    document.getElementById('restart').addEventListener('click', function() { document.getElementById('shutdown-screen').hidden = true; });
    const gameBoard = document.getElementById('game-board');
    let player = { x: 1, y: 1 };
    let pixels = [{x:7,y:1},{x:3,y:3},{x:8,y:4},{x:2,y:6},{x:6,y:7}];
    const walls = new Set(['4,0','4,1','4,2','4,4','4,5','4,6','1,4','2,4','6,3','7,3']);
    function renderGame() {
      gameBoard.innerHTML = '';
      for (let y = 0; y < 9; y++) {
        for (let x = 0; x < 10; x++) {
          const cell = document.createElement('i');
          if (walls.has(String(x) + ',' + String(y))) cell.className = 'wall';
          if (pixels.some(function(pixel) { return pixel.x === x && pixel.y === y; })) cell.className = 'pixel';
          if (player.x === x && player.y === y) { cell.className = 'player'; cell.textContent = 'P'; }
          gameBoard.appendChild(cell);
        }
      }
      document.getElementById('game-score').textContent = String(5 - pixels.length);
      if (!pixels.length) document.getElementById('game-message').textContent = 'Has restaurado los píxeles perdidos.';
    }
    function movePlayer(dx, dy) {
      const next = { x: Math.max(0, Math.min(9, player.x + dx)), y: Math.max(0, Math.min(8, player.y + dy)) };
      if (!walls.has(String(next.x) + ',' + String(next.y))) player = next;
      pixels = pixels.filter(function(pixel) { return pixel.x !== player.x || pixel.y !== player.y; });
      renderGame();
    }
    const moves = { ArrowUp:[0,-1], ArrowDown:[0,1], ArrowLeft:[-1,0], ArrowRight:[1,0] };
    document.addEventListener('keydown', function(event) { if (!document.getElementById('window-game').hidden && moves[event.key]) { event.preventDefault(); movePlayer.apply(null, moves[event.key]); } });
    document.querySelectorAll('[data-move]').forEach(function(button) { button.addEventListener('click', function() { const map = { up:[0,-1], down:[0,1], left:[-1,0], right:[1,0] }; movePlayer.apply(null, map[button.dataset.move]); }); });
    renderGame();
    const konami = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
    let secretIndex = 0;
    document.addEventListener('keydown', function(event) { secretIndex = event.key === konami[secretIndex] ? secretIndex + 1 : 0; if (secretIndex === konami.length) { showWindow('game'); secretIndex = 0; } });
    openFolderNow('all');
    if (matchMedia('(max-width: 700px)').matches) closeWindow(explorer);
  </script>
</body>
</html>
