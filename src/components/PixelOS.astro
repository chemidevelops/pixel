          win.style.left = Math.max(0, event.clientX - width / 2) + 'px';
          win.style.top = '24px';
        }
        dragging = true;
        if (isMobile()) {
          // Read position before touching anything
          var pinL = win.offsetLeft, pinT = win.offsetTop, pinW = win.offsetWidth, pinH = win.offsetHeight;
          // Clear inset shorthand first (it would override individual left/top if set after)
          win.style.setProperty('inset', 'auto', 'important');
          win.style.setProperty('right', 'auto', 'important');
          win.style.setProperty('bottom', 'auto', 'important');
          win.style.setProperty('width', pinW + 'px', 'important');
          if (!win.classList.contains('no-resize')) win.style.setProperty('height', pinH + 'px', 'important');
          win.style.setProperty('left', pinL + 'px', 'important');
          win.style.setProperty('top', pinT + 'px', 'important');
        }
        offsetX = event.clientX - win.offsetLeft;
        offsetY = event.clientY - win.offsetTop;
        bar.setPointerCapture(event.pointerId);
        if (!isMobile()) {
          ghostEl = document.createElement('div');
          ghostEl.className = 'window-drag-outline';
          ghostEl.style.left = win.offsetLeft + 'px';
          ghostEl.style.top = win.offsetTop + 'px';
          ghostEl.style.width = win.offsetWidth + 'px';
          ghostEl.style.height = win.offsetHeight + 'px';
          document.querySelector('.desktop').appendChild(ghostEl);
