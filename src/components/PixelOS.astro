      document.getElementById('mp-rew').addEventListener('click', function() { vid.currentTime = Math.max(0, vid.currentTime - 10); });
      document.getElementById('mp-fwd').addEventListener('click', function() { vid.currentTime = Math.min(vid.duration || 0, vid.currentTime + 10); });
      document.getElementById('mp-prev').addEventListener('click', function() { vid.currentTime = 0; });
      document.getElementById('mp-next').addEventListener('click', function() { vid.currentTime = vid.duration || 0; });
      volSlider.addEventListener('input', function() { vid.volume = parseInt(volSlider.value, 10) / 100; });

      seek.addEventListener('pointerdown', function() { seek._seeking = true; });
      seek.addEventListener('input', function() { if (vid.duration) vid.currentTime = (parseInt(seek.value, 10) / 1000) * vid.duration; });
      seek.addEventListener('pointerup', function() { seek._seeking = false; });

      document.getElementById('window-mplayer').addEventListener('close-window', function() { vid.pause(); vid.src = ''; });
