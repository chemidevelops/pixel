      const volSlider = document.getElementById('mp-volume');
      const timeEl = document.getElementById('mp-time');
      const statusEl = document.getElementById('mp-status');

      function fmt(s) {
        s = Math.floor(s || 0);
        return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
      }
      vid.addEventListener('timeupdate', function() {
        if (!seek._seeking) seek.value = Math.round((vid.currentTime / (vid.duration || 1)) * 1000);
        timeEl.textContent = fmt(vid.currentTime) + ' / ' + fmt(vid.duration);
      });
      vid.addEventListener('playing', function() { statusEl.textContent = 'Reproduciendo'; });
      vid.addEventListener('pause', function() { statusEl.textContent = 'En pausa'; });
      vid.addEventListener('ended', function() { statusEl.textContent = 'Listo'; seek.value = 0; });
      vid.addEventListener('waiting', function() { statusEl.textContent = 'Cargando...'; });
      vid.addEventListener('canplay', function() { if (vid.paused) statusEl.textContent = 'Listo'; });

      playBtn.addEventListener('click', function() { if (vid.paused) vid.play(); else vid.pause(); });
