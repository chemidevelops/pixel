      });
      bar.addEventListener('pointermove', function(event) {
        if (!dragging) return;
        if (isMobile()) {
          win.style.setProperty('left', (event.clientX - offsetX) + 'px', 'important');
          win.style.setProperty('top', Math.max(0, event.clientY - offsetY) + 'px', 'important');
          return;
        }
        if (!ghostEl) return;
        ghostEl.style.left = String(Math.max(0, event.clientX - offsetX)) + 'px';
        ghostEl.style.top = String(Math.max(0, event.clientY - offsetY)) + 'px';
      });
      function endDrag() {
        if (ghostEl) {
          win.style.left = ghostEl.style.left;
          win.style.top = ghostEl.style.top;
          ghostEl.remove();
          ghostEl = null;
