      if (id === 'winamp') {
        launchWebamp();
        startMenu.hidden = true;
        return;
      }
      const win = document.getElementById('window-' + id);
      if (!win) return;
      win.hidden = false;
      win.classList.remove('minimized');
      focusWindow(win);
      syncTasks();
      startMenu.hidden = true;
      if (id === 'taisei') { win.dispatchEvent(new Event('taisei-open')); setTimeout(function() { document.getElementById('taisei-frame').focus(); }, 600); }
    }

