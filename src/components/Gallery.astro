---
type ImageItem = string | { src: string; caption?: string };
interface Props {
  images: ImageItem[];
}
const { images } = Astro.props;
if (!images || images.length < 2) return;

const items = images.map(img =>
  typeof img === 'string' ? { src: img, caption: undefined } : img
);
---

<div class="gallery-wrap">
  <div class="gallery-track">
    {items.map(({ src, caption }, i) => (
      <div class="gallery-slide" data-index={i}>
        <img src={src} alt={caption ?? `Imagen ${i + 1}`} />
        {caption && <p class="gallery-caption">{caption}</p>}
      </div>
    ))}
  </div>
  <button class="gallery-btn gallery-prev" aria-label="Anterior">←</button>
  <button class="gallery-btn gallery-next" aria-label="Siguiente">→</button>
</div>

<style>
.gallery-wrap {
  position: relative;
  width: 100vw;
  left: 50%;
  transform: translateX(-50%);
  margin: 2.5rem 0;
  height: 600px;
  overflow: hidden;
  background-color: var(--bg);
  background-image: radial-gradient(var(--border) 1px, transparent 1px);
  background-size: 18px 18px;
}

.gallery-track {
  position: relative;
  width: 100%;
  height: 100%;
}

.gallery-slide {
  position: absolute;
  top: 50%;
  left: 50%;
  transition: transform 0.45s cubic-bezier(0.25, 0.46, 0.45, 0.94),
              opacity   0.45s ease,
              filter    0.45s ease;
  cursor: pointer;
}

.gallery-slide img {
  display: block;
  width: 900px;
  height: 520px;
  object-fit: cover;
  margin: 0;
}

.gallery-caption {
  margin: 0;
  padding: 0.45rem 0.6rem;
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--text-muted);
  text-align: center;
  background: var(--bg);
  width: 900px;
  box-sizing: border-box;
  letter-spacing: 0.03em;
}

@media (max-width: 700px) {
  .gallery-wrap { height: auto; }
  .gallery-track { position: relative; height: auto; }

  .gallery-slide {
    position: relative;
    top: auto;
    left: auto;
    transform: none !important;
    display: none;
    opacity: 1 !important;
    filter: none !important;
  }
  .gallery-slide[data-pos="0"] { display: block; }

  .gallery-slide img {
    width: 100%;
    height: auto;
  }

  .gallery-caption { width: 100%; }
}

/* Centro */
.gallery-slide[data-pos="0"] {
  transform: translate(-50%, -50%);
  opacity: 1;
  filter: none;
  z-index: 3;
  cursor: default;
}
/* Derecha */
.gallery-slide[data-pos="1"] {
  transform: translate(calc(-50% + 820px), -50%) scale(0.82);
  opacity: 0.45;
  filter: blur(4px);
  z-index: 2;
}
/* Izquierda */
.gallery-slide[data-pos="-1"] {
  transform: translate(calc(-50% - 820px), -50%) scale(0.82);
  opacity: 0.45;
  filter: blur(4px);
  z-index: 2;
}
/* Ocultos */
.gallery-slide[data-pos="2"] {
  transform: translate(calc(-50% + 1200px), -50%) scale(0.65);
  opacity: 0;
  z-index: 1;
  pointer-events: none;
}
.gallery-slide[data-pos="-2"] {
  transform: translate(calc(-50% - 1200px), -50%) scale(0.65);
  opacity: 0;
  z-index: 1;
  pointer-events: none;
}

.gallery-btn {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  background: rgba(0,0,0,0.35);
  border: none;
  color: #fff;
  font-family: var(--font-mono);
  font-size: 1.4rem;
  font-weight: 700;
  width: 52px;
  height: 52px;
  cursor: pointer;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.15s;
}
.gallery-btn:hover { background: var(--red); }
.gallery-prev { left: 0; }
.gallery-next { right: 0; }
</style>

<script>
(function() {
  const wrap = document.querySelector('.gallery-wrap');
  if (!wrap) return;
  const slides = [...wrap.querySelectorAll('.gallery-slide')] as HTMLElement[];
  const n = slides.length;
  let current = 0;

  function mod(x: number, m: number) { return ((x % m) + m) % m; }

  function render() {
    slides.forEach((slide, i) => {
      let p = mod(i - current, n);
      if (p > n / 2) p = p - n;
      if (p > 2) p = 2;
      if (p < -2) p = -2;
      slide.setAttribute('data-pos', String(p));
    });
  }

  function go(dir: number) { current = mod(current + dir, n); render(); }

  wrap.querySelector('.gallery-prev')?.addEventListener('click', () => go(-1));
  wrap.querySelector('.gallery-next')?.addEventListener('click', () => go(1));

  slides.forEach(slide => {
    slide.addEventListener('click', () => {
      const pos = parseInt(slide.getAttribute('data-pos') || '0');
      if (pos !== 0) go(pos > 0 ? 1 : -1);
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowLeft')  go(-1);
    if (e.key === 'ArrowRight') go(1);
  });

  render();
})();
</script>
