---
import { getCollection } from 'astro:content';

const allPosts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const thumbs: Record<string, string> = {
  'shinobi-arcade':               '/images/shinobi-gameplay.png',
  'mina-the-hollower':            '/images/mina-the-hollower-gameplay.jpg',
  'outrun':                       '/images/outrun-gameplay.png',
  'bounty-sister':                '/images/bounty-3.jpg',
  'ball-x-pit':                   '/images/ballxpit-4.jpg',
  'andro-dunos-ii-entrevista':    '/images/andro_dunos_1.jpg',
  'el-tiempo-en-los-videojuegos': '/images/outrun-1.jpg',
};

const recent = allPosts.slice(0, 5);
