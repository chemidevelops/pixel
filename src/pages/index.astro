---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
const newest = posts.slice(0, 7);
const classics = [...posts].sort((a, b) => a.data.title.localeCompare(b.data.title, 'es')).slice(0, 7);
const tags = [...new Set(posts.flatMap(post => post.data.tags ?? []))].sort();
---
<Base title="Inicio">
  <section class="home-about">
    <h1>PIXEL</h1>
    <p>
      Esta es una revista independiente sobre videojuegos. Escribimos sobre diseño,
      historia y cultura del medio: sin notas numéricas, noticias de última hora ni
      textos dictados por el calendario.
    </p>
    <p class="home-note">
      <strong>NAVEGACIÓN:</strong> consulta el <a href="/posts">archivo completo</a>,
      descarga el <a href="/descargas">fanzine imprimible</a>, conoce
      <a href="/sobre">el proyecto</a> o sigue las publicaciones mediante
      <a href="/rss.xml">RSS</a>.
    </p>
    <p class="home-note">
      <strong>LECTURA:</strong> los artículos están pensados para leerse despacio.
      El panel inferior permite cambiar el tamaño del texto, el contraste fotográfico
      y el modo claro u oscuro.
    </p>
  </section>

  <div class="home-columns">
    <section class="directory-section">
      <h2><a href="/posts">Nuevos</a></h2>
      <ul class="directory-list">
        {newest.map(post => (
          <li>
            <span class="list-glyph">◆</span>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="directory-section">
      <h2>Índice</h2>
      <ul class="directory-list">
        {classics.map(post => (
          <li>
            <span class="list-glyph">◇</span>
            <a href={`/posts/${post.id}`}>{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <section class="topic-directory">
    <h2>Temas</h2>
    <div class="topic-grid">
      {tags.map(tag => (
        <a href={`/tags/${tag}`}>{tag}</a>
      ))}
      <a href="/tags/nº1">nº1</a>
    </div>
  </section>
</Base>
