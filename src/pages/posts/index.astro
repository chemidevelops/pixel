---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const allTags = [...new Set(posts.flatMap(p => p.data.tags ?? []))].sort();
const allIssues = [...new Set(posts.map(p => p.data.issue).filter(Boolean))].sort((a, b) => a - b);
const postsByYear = posts.reduce<Record<string, typeof posts>>((groups, post) => {
  const year = String(new Date(post.data.date).getFullYear());
  (groups[year] ??= []).push(post);
  return groups;
}, {});
const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---
<Base title="Artículos" description="Todos los artículos de PIXEL — crítica y cultura de videojuegos">
  <div class="archive-intro">
    <h1>Archivo</h1>
    <p>Índice cronológico de los artículos publicados en PIXEL.</p>
    <div class="tag-filter">
      {allIssues.map(issue => (
        <a href={`/tags/nº${issue}`} class="post-tag post-tag-issue">nº{issue}</a>
      ))}
      {allTags.map(tag => (
        <a href={`/tags/${tag}`} class="post-tag">{tag}</a>
      ))}
    </div>
  </div>

  <div class="year-groups">
    {years.map(year => (
      <section class="year-group">
        <h2>{year}</h2>
        <ul>
          {postsByYear[year]?.map(post => (
            <li>
              <span class="list-glyph">◆</span>
              <a href={`/posts/${post.id}`}>{post.data.title}</a>
              <time>{new Date(post.data.date).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit' })}</time>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<style>
.tag-filter {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  font-family: var(--font-mono);
  font-size: 0.78rem;
}
</style>
