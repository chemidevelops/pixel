---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const issues = await getCollection('issues');
const posts = await getCollection('posts');

const sortedIssues = issues.sort((a, b) => b.data.number - a.data.number);
---
<Base title="Descargas" description="Descarga los números de PIXEL en formato fanzine imprimible">
  <h1>Descargas</h1>
  <p style="color:var(--text-muted); margin-bottom:2.5rem; font-size:0.95rem;">
    Cada número reúne una selección de artículos en formato fanzine A5 imprimible.
    Dóblalo por la mitad, grápalo en el lomo y listo.
  </p>

  {sortedIssues.length === 0 && (
    <p style="color:var(--text-muted); font-style:italic;">El primer número está en camino.</p>
  )}

  {sortedIssues.map(issue => {
    const issuePosts = posts.filter(p => p.data.issue === issue.data.number);
    return (
      <div class="issue-card" id={`numero-${issue.data.number}`}>
        <div>
          <div class="issue-number">Número {issue.data.number} · {issue.data.date}</div>
          <div class="issue-title">{issue.data.title}</div>
          <div class="issue-count">{issuePosts.length} artículos</div>
          <ul style="margin-top:0.75rem; font-size:0.82rem; padding-left:1rem;">
            {issuePosts.map(p => (
              <li><a href={`/posts/${p.slug}`}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.5rem; align-self:center;">
          {issue.data.pdf && (
            <a href={issue.data.pdf} class="btn-download" download>
              ↓ Leer en pantalla
            </a>
          )}
          {issue.data.pdf_print && (
            <a href={issue.data.pdf_print} class="btn-download" style="background:transparent; color:var(--text); border:1.5px solid var(--text);" download>
              ↓ Versión para imprimir
            </a>
          )}
          {!issue.data.pdf && (
            <span style="font-family:var(--font-mono); font-size:0.72rem; color:var(--text-muted);">Próximamente</span>
          )}
        </div>
      </div>
    );
  })}

  <div style="margin-top:3rem; padding:1.25rem; border:1px solid var(--border); font-size:0.82rem; color:var(--text-muted);">
    <strong style="font-family:var(--font-mono); font-size:0.72rem; letter-spacing:0.08em; text-transform:uppercase;">Cómo imprimir</strong>
    <p style="margin-top:0.5rem; margin-bottom:0;">Imprime en A4 a doble cara, orientación vertical. Dobla el papel por la mitad — quedarán páginas A5. Grapa en el lomo o usa un clip. El PDF incluye las instrucciones al final.</p>
  </div>
</Base>
