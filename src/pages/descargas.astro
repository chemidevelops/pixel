---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const issues = await getCollection('issues');
const posts = await getCollection('posts');

const sortedIssues = issues.sort((a, b) => b.data.number - a.data.number);
---
<Base title="Descargas" description="Descarga los números de PIXEL en formato fanzine imprimible">
  <h1>Descargas</h1>
  <p style="color:var(--text-muted); margin-bottom:2.5rem; font-size:0.95rem;">
    Cada número reúne una selección de artículos en formato fanzine A5 imprimible.
    Dóblalo por la mitad, grápalo en el lomo y listo.
  </p>

  {sortedIssues.length === 0 && (
    <p style="color:var(--text-muted); font-style:italic;">El primer número está en camino.</p>
  )}

  {sortedIssues.map(issue => {
    const issuePosts = posts.filter(p => p.data.issue === issue.data.number);
    return (
      <div class="issue-card" id={`numero-${issue.data.number}`}>
        <div>
          <div class="issue-number">Número {issue.data.number} · {issue.data.date}</div>
          <div class="issue-title">{issue.data.title}</div>
          <div class="issue-count">{issuePosts.length} artículos</div>
          <ul style="margin-top:0.75rem; font-size:0.82rem; padding-left:1rem;">
            {issuePosts.map(p => (
              <li><a href={`/posts/${p.slug}`}>{p.data.title}</a></li>
            ))}
          </ul>
        </div>
        <div style="display:flex; flex-direction:column; gap:0.5rem; align-self:center;">
          {issue.data.pdf && (
            <a href={issue.data.pdf} class="btn-download" download>
              ↓ Leer en pantalla
            </a>
          )}
          {issue.data.pdf_print && (
            <a href={issue.data.pdf_print} class="btn-download" style="background:transparent; color:var(--text); border:1.5px solid var(--text);" download>
              ↓ Versión para imprimir
            </a>
          )}
          {!issue.data.pdf && (
            <span style="font-family:var(--font-mono); font-size:0.72rem; color:var(--text-muted);">Próximamente</span>
          )}
        </div>
      </div>
    );
  })}

  <div class="how-to-print">
    <p class="how-label">CÓMO IMPRIMIR</p>
    <div class="how-steps">

      <div class="how-step">
        <div class="how-diagram">
          <svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg">
            <!-- Hoja A4 apaisada -->
            <rect x="5" y="20" width="110" height="50" fill="none" stroke="currentColor" stroke-width="2"/>
            <!-- Línea de doblez vertical en el centro -->
            <line x1="60" y1="20" x2="60" y2="70" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
            <!-- A y B en cada mitad -->
            <text x="32" y="48" text-anchor="middle" font-size="9" font-family="monospace" fill="currentColor">A</text>
            <text x="88" y="48" text-anchor="middle" font-size="9" font-family="monospace" fill="currentColor">B</text>
          </svg>
        </div>
        <p class="how-desc"><strong>01 — Imprime</strong><br/>A4 a doble cara.<br/>Volteo por borde largo.</p>
      </div>

      <div class="how-arrow">→</div>

      <div class="how-step">
        <div class="how-diagram">
          <svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg">
            <!-- Hojas apiladas -->
            <rect x="18" y="18" width="76" height="60" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3"/>
            <rect x="14" y="14" width="76" height="60" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.5"/>
            <rect x="10" y="10" width="76" height="60" fill="none" stroke="currentColor" stroke-width="2"/>
            <!-- Línea de doblez -->
            <line x1="48" y1="10" x2="48" y2="70" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"/>
          </svg>
        </div>
        <p class="how-desc"><strong>02 — Apila</strong><br/>Las hojas en orden,<br/>una sobre otra.</p>
      </div>

      <div class="how-arrow">→</div>

      <div class="how-step">
        <div class="how-diagram">
          <svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg">
            <!-- Revista doblada vista lateral -->
            <path d="M 30 15 L 75 15 L 75 75 L 30 75 Z" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="30" y1="15" x2="30" y2="75" stroke="currentColor" stroke-width="3"/>
            <!-- Flecha de doblez -->
            <path d="M 85 30 Q 95 45 85 60" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 2"/>
            <polyline points="83,57 85,60 88,57" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </div>
        <p class="how-desc"><strong>03 — Dobla</strong><br/>Por la mitad.<br/>Quedan páginas A5.</p>
      </div>

      <div class="how-arrow">→</div>

      <div class="how-step">
        <div class="how-diagram">
          <svg viewBox="0 0 120 90" xmlns="http://www.w3.org/2000/svg">
            <!-- Revista final -->
            <path d="M 30 15 L 75 15 L 75 75 L 30 75 Z" fill="none" stroke="currentColor" stroke-width="2"/>
            <line x1="30" y1="15" x2="30" y2="75" stroke="currentColor" stroke-width="3"/>
            <!-- Grapas -->
            <rect x="26" y="30" width="8" height="5" fill="currentColor" rx="1"/>
            <rect x="26" y="55" width="8" height="5" fill="currentColor" rx="1"/>
          </svg>
        </div>
        <p class="how-desc"><strong>04 — Grapa</strong><br/>Dos grapas en el lomo.<br/>O usa un clip.</p>
      </div>

    </div>
  </div>
</Base>
